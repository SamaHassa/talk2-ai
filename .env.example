# Copy to .env and fill in. Never commit .env.
# Free options: groq (free API key at console.groq.com), gemini (free key at aistudio.google.com),
# ollama (install from ollama.com, run `ollama pull qwen2.5:7b`, no key needed).
TALK2AI_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=                 # for TALK2AI_PROVIDER=huggingface
# TALK2AI_MODEL=            # optional: override the provider's default model
